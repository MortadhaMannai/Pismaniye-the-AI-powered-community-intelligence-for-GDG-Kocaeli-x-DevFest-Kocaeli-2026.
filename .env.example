# PISMANIYE Environment Configuration (Copy to .env for local customization)
PISMANIYE_EVENT_ID=devfest-kocaeli-2026
PISMANIYE_EVENT_NAME="DevFest Kocaeli 2026"
# Modes: local_deterministic (default, no API keys needed) | google_cloud | hybrid
PISMANIYE_MODE=local_deterministic

# Google GenAI SDK / Vertex AI (Leave empty for local_deterministic mode)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
PISMANIYE_GEMINI_MODEL=gemini-2.5-flash
PISMANIYE_EMBEDDING_MODEL=text-embedding-004

# Storage & Web App (Set your deployed Cloud Run / public domain URL for stage QR codes)
PISMANIYE_HOST=0.0.0.0
PISMANIYE_PORT=8080
PISMANIYE_PUBLIC_WEB_URL=https://pismaniye-concierge.gdgkocaeli.dev
# Set your custom organizer passcode at runtime in .env (if unset, an ephemeral session passcode is generated)
PISMANIYE_ORGANIZER_PASSCODE=
